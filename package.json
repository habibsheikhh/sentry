{
  "name": "sentry",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter web dev",
    "dev:api": "bun run --filter api dev",
    "dev:worker": "bun run --filter worker dev"
  },
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "tailwindcss": "^4.3.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
